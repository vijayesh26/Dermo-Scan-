# DermoScan Environment Variables
# Copy to .env and replace with your credentials if desired.
# If omitted, DermoScan seamlessly runs using its built-in Clinical Simulation Engine and local session storage!

# Anthropic Claude API Key (Optional)
VITE_ANTHROPIC_API_KEY=

# Supabase Configuration (Optional)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
